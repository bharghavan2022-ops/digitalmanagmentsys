# Postgres connection string used by Prisma (Supabase "Connection pooling" URI)
DATABASE_URL="postgresql://postgres:password@localhost:5432/nss_connect"
# Direct (non-pooled) connection, used by `prisma migrate`
DIRECT_URL="postgresql://postgres:password@localhost:5432/nss_connect"

# Supabase project
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-anon-key"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"

# Signing secret for short-lived attendance check-in tokens and certificate
# verification hashes. Generate with: openssl rand -hex 32
APP_SIGNING_SECRET="replace-with-a-long-random-secret"

# Optional: email delivery for announcements. Leave both unset to keep
# announcements in-app only.
RESEND_API_KEY="replace-with-resend-key"
# Must be exactly "onboarding@resend.dev" (Resend's shared test sender)
# unless you've verified your own domain in the Resend dashboard, in which
# case use an address at that domain, e.g. "NSS Connect <noreply@yourdomain.org>".
RESEND_FROM_EMAIL="NSS Connect <onboarding@resend.dev>"

# Base URL used to build public verification links in certificates
NEXT_PUBLIC_APP_URL="http://localhost:3000"
